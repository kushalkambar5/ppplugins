{
  "manifestVersion": 5,
  "id": "com.kushagra.silentsegmentdetector",
  "name": "Silent Segment Detection & Removal",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "silent-segment-panel",
      "label": "Silent Segment Detector",
      "minimumSize": { "width": 380, "height": 550 },
      "maximumSize": { "width": 1200, "height": 1600 },
      "preferredDockedSize": { "width": 450, "height": 750 },
      "preferredFloatingSize": { "width": 480, "height": 800 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/icon-23.png", "scale": [ 1, 2 ] }
      ]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:38271",
        "http://localhost:38271",
        "ws://127.0.0.1:38271",
        "ws://localhost:38271",
        "all"
      ]
    },
    "launchProcess": {
      "schemes": [ "http", "https" ],
      "extensions": [ ".exe", ".bat", ".py", ".cmd", ".sh", ".json", ".wav", ".mp4" ]
    },
    "clipboard": "readAndWrite",
    "localFileSystem": "fullAccess"
  },
  "icons": [
    { "width": 48, "height": 48, "path": "icons/icon-48.png" }
  ]
}
